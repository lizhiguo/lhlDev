<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lhl.demo.dict.adapter.out.read.mybatis.DictItemReadMapper">

    <sql id="baseColumns">
        id, dict_type_code, item_code, item_name, sort, status, remark, create_time, update_time
    </sql>

    <resultMap id="DictItemViewMap" type="com.lhl.demo.dict.api.model.DictItemView">
        <id property="id" column="id"/>
        <result property="dictTypeCode" column="dict_type_code"/>
        <result property="itemCode" column="item_code"/>
        <result property="itemName" column="item_name"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="statusDesc" column="status_desc"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="whereClause">
        <where>
            <if test="cond.dictTypeCode != null and cond.dictTypeCode != ''">
                AND dict_type_code = #{cond.dictTypeCode}
            </if>
            <if test="cond.itemCode != null and cond.itemCode != ''">
                AND item_code = #{cond.itemCode}
            </if>
            <if test="cond.itemName != null and cond.itemName != ''">
                AND item_name LIKE CONCAT('%', #{cond.itemName}, '%')
            </if>
            <if test="cond.status != null and cond.status != ''">
                AND status = #{cond.status}
            </if>
        </where>
    </sql>

    <select id="selectById" resultMap="DictItemViewMap">
        SELECT <include refid="baseColumns"/>,
               CASE status WHEN 'ENABLED' THEN '启用' WHEN 'DISABLED' THEN '停用' ELSE '' END AS status_desc
        FROM dict_item
        WHERE id = #{id}
    </select>

    <select id="selectListByCond" resultMap="DictItemViewMap">
        SELECT <include refid="baseColumns"/>,
               CASE status WHEN 'ENABLED' THEN '启用' WHEN 'DISABLED' THEN '停用' ELSE '' END AS status_desc
        FROM dict_item
        <include refid="whereClause"/>
        ORDER BY sort ASC, create_time DESC
    </select>

</mapper>
