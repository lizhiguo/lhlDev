<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lhl.demo.dict.adapter.out.read.mybatis.DictTypeReadMapper">

    <sql id="baseColumns">
        id, dict_code, name, description, status, create_time, update_time
    </sql>

    <resultMap id="DictTypeViewMap" type="com.lhl.demo.dict.api.model.DictTypeView">
        <id property="id" column="id"/>
        <result property="dictCode" column="dict_code"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="statusDesc" column="status_desc"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="whereClause">
        <where>
            <if test="cond.dictCode != null and cond.dictCode != ''">
                AND dict_code = #{cond.dictCode}
            </if>
            <if test="cond.name != null and cond.name != ''">
                AND name LIKE CONCAT('%', #{cond.name}, '%')
            </if>
            <if test="cond.status != null and cond.status != ''">
                AND status = #{cond.status}
            </if>
        </where>
    </sql>

    <select id="selectById" resultMap="DictTypeViewMap">
        SELECT <include refid="baseColumns"/>,
               CASE status WHEN 'ENABLED' THEN '启用' WHEN 'DISABLED' THEN '停用' ELSE '' END AS status_desc
        FROM dict_type
        WHERE id = #{id}
    </select>

    <select id="selectListByCond" resultMap="DictTypeViewMap">
        SELECT <include refid="baseColumns"/>,
               CASE status WHEN 'ENABLED' THEN '启用' WHEN 'DISABLED' THEN '停用' ELSE '' END AS status_desc
        FROM dict_type
        <include refid="whereClause"/>
        ORDER BY create_time DESC
    </select>

</mapper>
