    });
%}

### 5.3 未绑定的 openId -> 401
# @name login-wx-unknown
POST {{baseUrl}}/wxLogin
Content-Type: application/json

{
  "wxId": "wx_not_bound",
  "type": "miniApp"
}

> {%
    client.test("未绑定 openId 返回 401", function () {
        client.assert(response.status === 401, "期望 401，实际 " + response.status);
    });
%}

#endregion


#region 6. 令牌校验与刷新

### 6.1 换一份完整令牌对（内置 /login 只给 accessToken，refreshToken 在这里取）
# @name auth-token
POST {{baseUrl}}/auth/token
Authorization: Bearer {{userToken}}

> {%
    client.test("签发完整令牌对", function () {
        client.assert(response.status === 200, "期望 200，实际 " + response.status);
        const d = response.body.data;
        client.assert(typeof d.accessToken === "string" && d.accessToken.length > 0, "缺少 accessToken");
        client.assert(typeof d.refreshToken === "string" && d.refreshToken.length > 0, "缺少 refreshToken");
        client.assert(d.tokenType === "Bearer", "tokenType 应为 Bearer");
        client.assert(d.expiresIn === 7200, "access token 有效期应为 7200 秒，实际 " + d.expiresIn);
        client.global.set("refreshToken", d.refreshToken);
    });
%}

### 6.2 刷新令牌：旧 refreshToken 被吊销（轮换），签发新的一对
# @name refresh-first
POST {{baseUrl}}/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("首次刷新成功", function () {
        client.assert(response.status === 200, "期望 200，实际 " + response.status);
        client.assert(response.body.succ === true, "期望刷新成功，实际 " + response.body.msg);
    });
%}

### 6.3 重复使用已轮换掉的 refreshToken -> 失败
# @name refresh-reuse
POST {{baseUrl}}/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("旧 refreshToken 已失效（轮换）", function () {
        client.assert(response.body.succ === false, "轮换后旧 refreshToken 不应再用成功");
    });
%}

### 6.4 refreshToken 为空 -> 业务失败
# @name refresh-empty
POST {{baseUrl}}/refresh
Content-Type: application/json

{}

> {%
    client.test("refreshToken 为空返回业务失败", function () {
        client.assert(response.status === 200, "接口本身返回 200，实际 " + response.status);
        client.assert(response.body.succ === false, "应返回 succ=false");
        client.assert(response.body.code === "400", "应返回 code=400，实际 " + response.body.code);
    });
%}

#endregion

#region 7. 权限校验（401=未认证，403=已认证但无权限）

### 7.1 admin：全部放行
# @name admin-list-users
GET {{baseUrl}}/user/list
Authorization: Bearer {{adminToken}}

> {%
    client.test("admin 拥有 USER_READ", function () {
        client.assert(response.status === 200, "期望 200，实际 " + response.status);
        client.assert(Array.isArray(response.body.data), "应返回用户数组");
        // 记下一个真实用户 ID，后续写操作复用，避免硬编码主键
        if (response.body.data.length > 0) {
            client.global.set("someUserId", response.body.data[0].id);
        }
    });
%}

# @name admin-roles
GET {{baseUrl}}/admin/roles
Authorization: Bearer {{adminToken}}

> {%
    client.test("admin 拥有 ROLE_ADMIN", function () {
        client.assert(response.status === 200, "期望 200，实际 " + response.status);
        client.assert(response.body.data.length >= 5, "角色清单应有 2 个角色 + 3 个权限");
    });
%}

# @name admin-write-user
POST {{baseUrl}}/user/{{someUserId}}/status?status=1
Authorization: Bearer {{adminToken}}

> {%
    client.test("admin 拥有 USER_WRITE", function () {
        client.assert(response.status === 200, "期望 200，实际 " + response.status);
        client.assert(response.body.succ === true, "期望写入成功，实际 " + response.body.msg);
        client.assert(response.body.data.status === 1, "状态应为 1");
    });
%}

# @name admin-delete-user
DELETE {{baseUrl}}/user/{{notExistUserId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("admin 拥有 USER_DELETE（目标不存在返回业务 404）", function () {
        client.assert(response.status === 200, "接口本身返回 200，实际 " + response.status);
        client.assert(response.body.code === "404", "应返回 code=404，实际 " + response.body.code);
    });
%}

### 7.2 lhl：只有 USER_READ
# @name lhl-list-users
GET {{baseUrl}}/user/list
Authorization: Bearer {{userToken}}

> {%
    client.test("lhl 拥有 USER_READ，可查列表", function () {
        client.assert(response.status === 200, "期望 200，实际 " + response.status);
    });
%}

# @name lhl-write-user-denied
POST {{baseUrl}}/user/{{someUserId}}/status?status=1
Authorization: Bearer {{userToken}}

> {%
    client.test("lhl 缺少 USER_WRITE，返回 403", function () {
        client.assert(response.status === 403, "期望 403，实际 " + response.status);
    });
%}

# @name lhl-admin-denied
GET {{baseUrl}}/admin/roles
Authorization: Bearer {{userToken}}

> {%
    client.test("lhl 不是管理员，返回 403", function () {
        client.assert(response.status === 403, "期望 403，实际 " + response.status);
    });
%}

### 7.3 guest：无任何角色/权限，全部 403
# @name guest-list-users-denied
GET {{baseUrl}}/user/list
Authorization: Bearer {{guestToken}}

> {%
    client.test("guest 缺少 USER_READ，返回 403", function () {
        client.assert(response.status === 403, "期望 403，实际 " + response.status);
    });
%}

# @name guest-admin-denied
GET {{baseUrl}}/admin/roles
Authorization: Bearer {{guestToken}}

> {%
    client.test("guest 无角色，返回 403", function () {
        client.assert(response.status === 403, "期望 403，实际 " + response.status);
    });
%}

#endregion


#region 8. token 攻击面

### 8.1 篡改签名的 token -> 401（tamperedToken 在 2.1 登录时一并生成）
# @name tampered-token
GET {{baseUrl}}/me
Authorization: Bearer {{tamperedToken}}

> {%
    client.test("签名被篡改的 token 返回 401", function () {
        client.assert(response.status === 401, "期望 401，实际 " + response.status);
    });
%}

### 8.2 alg=none 伪造 -> 401
# @name alg-none-token
GET {{baseUrl}}/me
Authorization: Bearer eyJhbGciOiJub25lIn0.eyJzdWIiOiJhZG1pbiIsInJvbGUiOiJST0xFX0FETUlOIn0.

> {%
    client.test("alg=none 伪造 token 返回 401", function () {
        client.assert(response.status === 401, "期望 401，实际 " + response.status);
    });
%}

#endregion


#region 9. 登出（放最后：会作废 adminToken）

### 9.1 登出前可访问
# @name me-before-logout
GET {{baseUrl}}/me
Authorization: Bearer {{adminToken}}

> {%
    client.test("登出前 token 有效", function () {
        client.assert(response.status === 200, "期望 200，实际 " + response.status);
    });
%}

### 9.2 登出
# @name logout
POST {{baseUrl}}/logout
Authorization: Bearer {{adminToken}}

> {%
    client.test("登出成功", function () {
        client.assert(response.status === 200, "期望 200，实际 " + response.status);
    });
%}

### 9.3 登出后 token 立即失效（黑名单）
# @name me-after-logout
GET {{baseUrl}}/me
Authorization: Bearer {{adminToken}}

> {%
    client.test("登出后 token 立即返回 401", function () {
        client.assert(response.status === 401, "期望 401，实际 " + response.status);
    });
%}

#endregion